---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;

const images = import.meta.glob('/src/assets/shots/**/*.{png,jpg,jpeg,webp}', {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

const image = images[`/src/assets/shots/${name}`]?.default;
---

{image ? (
  <figure class="shot">
    <Image src={image} alt={alt} loading="lazy" />
    {caption ? <figcaption>{caption}</figcaption> : null}
  </figure>
) : import.meta.env.DEV ? (
  <div class="shot-missing">Screenshot needed: {name}: {alt}</div>
) : null}

<style>
  .shot {
    margin: 1.5rem 0;
  }

  .shot figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }

  .shot-missing {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 2px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
