---
/**
 * An inline rule level: a small solid badge. MUST is red, SHOULD is amber,
 * RECOMMENDED is blue. The word is inside the badge, so colour is never the
 * only signal.
 */
interface Props {
  level: 'MUST' | 'SHOULD' | 'RECOMMENDED';
}

const { level } = Astro.props;
---

<span class="rule-level" data-level={level}>{level}</span>

<style>
  .rule-level {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.42rem;
    border-radius: 0.25rem;
    background: var(--c-info-solid);
    color: var(--c-info-on);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: 0.08em;
  }

  .rule-level[data-level='MUST'] {
    background: var(--c-bad-solid);
    color: var(--c-bad-on);
  }

  .rule-level[data-level='SHOULD'] {
    background: var(--c-careful-solid);
    color: var(--c-careful-on);
  }
</style>
