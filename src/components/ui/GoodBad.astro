---
/**
 * A good example and a bad example, side by side. Each side keeps an icon and
 * the word, so colour is never the only signal.
 */
interface Props {
  goodLabel?: string;
  badLabel?: string;
}

const { goodLabel = 'Right', badLabel = 'Wrong' } = Astro.props;
---

<div class="good-bad">
  <div class="side" data-tone="good">
    <p class="heading">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="m8 12 3 3 5-6"></path>
      </svg>
      <span>{goodLabel}</span>
    </p>
    <div class="body"><slot name="good" /></div>
  </div>
  <div class="side" data-tone="bad">
    <p class="heading">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="m15 9-6 6M9 9l6 6"></path>
      </svg>
      <span>{badLabel}</span>
    </p>
    <div class="body"><slot name="bad" /></div>
  </div>
</div>

<style>
  .good-bad {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-block: 1.75rem;
  }

  .side {
    --side-ink: var(--c-info-ink);
    --side-tint: var(--sl-color-gray-7);
    --side-border: var(--sl-color-gray-5);
    min-width: 0;
    padding: 1rem 1.15rem 1.1rem;
    border: 1px solid var(--side-border);
    border-radius: 0.75rem;
    background: var(--side-tint);
  }

  .side[data-tone='good'] {
    --side-ink: var(--c-good-ink);
    --side-tint: var(--c-good-tint);
    --side-border: var(--c-good-border);
  }

  .side[data-tone='bad'] {
    --side-ink: var(--c-bad-ink);
    --side-tint: var(--c-bad-tint);
    --side-border: var(--c-bad-border);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.55rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--side-ink);
  }

  .heading svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .body {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    line-height: 1.55;
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 0.5rem;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  .body :global(li + li) {
    margin-top: 0.35rem;
  }

  .body :global(code) {
    font-size: 0.9em;
  }

  @media (min-width: 50rem) {
    .good-bad {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>
